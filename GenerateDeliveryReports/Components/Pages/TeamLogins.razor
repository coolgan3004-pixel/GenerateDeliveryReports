@page "/admin/team-logins"
@attribute [Authorize(Policy = "RequireExternalLogin")]
@rendermode InteractiveServer
@using System.Security.Cryptography
@using GenerateDeliveryReports.Identity
@using Microsoft.AspNetCore.Identity
@using QRCoder
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<TeamLogins> Logger

<PageTitle>Team Logins</PageTitle>

<div class="container-fluid" style="max-width:760px">
    <h3 class="mb-3">Create Team Login</h3>
    <p class="text-muted small">
        Creates a local sign-in for a team member. They'll need to set up an authenticator app
        (TOTP) with the key below before they can use the app — hand over the username, password,
        and authenticator key together through a secure channel.
    </p>
    <p class="text-muted small">
        The login page's Email field requires an email-shaped value to accept input at all, so
        usernames are generated as <code>firstname.lastname@teamlogin.local</code> — it isn't a
        real mailbox, just the sign-in identifier.
    </p>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">First Name</label>
                    <input class="form-control" @bind="_firstName" @bind:event="oninput" disabled="@_creating" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Last Name</label>
                    <input class="form-control" @bind="_lastName" @bind:event="oninput" disabled="@_creating" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger py-2 px-3 small">@_errorMessage</div>
            }

            <button class="btn btn-primary" @onclick="CreateLogin" disabled="@(_creating || string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))">
                @if (_creating)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Create Login
            </button>
        </div>
    </div>

    @if (_result != null)
    {
        <div class="card mb-4 border-success">
            <div class="card-header bg-success-subtle fw-semibold">Login created — copy these now, the password won't be shown again</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-3">Username</dt>
                    <dd class="col-sm-9"><code>@_result.Username</code></dd>

                    <dt class="col-sm-3">Password</dt>
                    <dd class="col-sm-9"><code>@_result.Password</code></dd>

                    <dt class="col-sm-3">Authenticator</dt>
                    <dd class="col-sm-9">
                        <img src="@_result.QrCodeDataUri" alt="Authenticator QR code" width="180" height="180"
                             style="border:1px solid #dee2e6; border-radius:6px; padding:6px;" />
                        <div class="mt-2">
                            <code>@_result.FormattedAuthenticatorKey</code>
                        </div>
                        <div class="text-muted mt-1">
                            Scan the QR code with an authenticator app (Microsoft/Google Authenticator, etc.), or use
                            the key above to enter it manually — same secret either way.
                        </div>
                    </dd>
                </dl>
            </div>
        </div>
    }

    <h5 class="mb-2">Existing Local Accounts</h5>
    @if (_localAccounts.Count == 0)
    {
        <p class="text-muted small">No local accounts yet.</p>
    }
    else
    {
        <div style="overflow-x: auto;">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Status</th>
                        <th>Authenticator</th>
                        <th>Created</th>
                        <th>Updated</th>
                        <th>Deactivated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in _localAccounts)
                    {
                        <tr>
                            <td>@account.UserName</td>
                            <td>
                                <span class="badge @(account.IsActive ? "bg-success" : "bg-secondary")">
                                    @(account.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@(account.TwoFactorEnabled ? "Yes" : "Not yet")</td>
                            <td><small>@account.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td><small>@(account.UpdatedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</small></td>
                            <td><small>@(account.DeactivatedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</small></td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    @if (account.IsActive)
                                    {
                                        <button class="btn btn-warning btn-sm" @onclick="() => ShowDeactivateConfirm(account)" title="Deactivate this login">
                                            Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-info btn-sm" @onclick="() => ReactivateLogin(account)" title="Reactivate this login">
                                            Reactivate
                                        </button>
                                    }
                                    <button class="btn btn-primary btn-sm" @onclick="() => ResetPassword(account)" title="Generate and show new password">
                                        Reset Password
                                    </button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => ShowDeleteConfirm(account)" title="Delete this login permanently">
                                        Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_resetPasswordResult != null)
    {
        <div class="card mt-4 border-info">
            <div class="card-header bg-info-subtle fw-semibold">Password reset for @_resetPasswordResult.Username</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-3">New Password</dt>
                    <dd class="col-sm-9"><code>@_resetPasswordResult.NewPassword</code></dd>
                </dl>
                <p class="text-muted small mt-2">Share this temporary password securely. The user must sign in and change it immediately.</p>
                <button class="btn btn-sm btn-secondary" @onclick="() => _resetPasswordResult = null">Close</button>
            </div>
        </div>
    }

    @if (_confirmAction != null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Action</h5>
                    </div>
                    <div class="modal-body">
                        <p>@_confirmAction.Message</p>
                        @if (!string.IsNullOrEmpty(_confirmAction.Warning))
                        {
                            <div class="alert alert-warning">@_confirmAction.Warning</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelConfirm">Cancel</button>
                        <button type="button" class="btn @_confirmAction.ButtonClass" @onclick="ConfirmAction" disabled="@_actionInProgress">
                            @if (_actionInProgress)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            @_confirmAction.ButtonText
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private sealed record CreatedLogin(string Username, string Password, string FormattedAuthenticatorKey, string QrCodeDataUri);
    private sealed record ResetPasswordResult(string Username, string NewPassword);
    private sealed record ConfirmActionInfo(string Message, string Warning, string ButtonText, string ButtonClass, Func<Task> Action);

    private const string Issuer = "GenerateDeliveryReports";

    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private bool _creating;
    private bool _actionInProgress;
    private string? _errorMessage;
    private CreatedLogin? _result;
    private ResetPasswordResult? _resetPasswordResult;
    private ConfirmActionInfo? _confirmAction;
    private List<ApplicationUser> _localAccounts = [];

    protected override async Task OnInitializedAsync()
    {
        await RefreshLocalAccountsAsync();
    }

    private async Task RefreshLocalAccountsAsync()
    {
        var accounts = new List<ApplicationUser>();
        foreach (var user in UserManager.Users.ToList())
        {
            var logins = await UserManager.GetLoginsAsync(user);
            if (logins.Count == 0) // local (non-Entra) accounts only
                accounts.Add(user);
        }
        _localAccounts = accounts.OrderBy(a => a.CreatedUtc).ToList();
    }

    private async Task CreateLogin()
    {
        _creating = true;
        _errorMessage = null;
        _result = null;
        StateHasChanged();

        try
        {
            var username = await GenerateUsernameAsync(_firstName.Trim(), _lastName.Trim());
            var password = GenerateStrongPassword();

            var user = new ApplicationUser { UserName = username, Email = username, EmailConfirmed = true, CreatedUtc = DateTime.UtcNow };
            var createResult = await UserManager.CreateAsync(user, password);
            if (!createResult.Succeeded)
            {
                _errorMessage = string.Join(" ", createResult.Errors.Select(e => e.Description));
                return;
            }

            // Generate (but don't yet enable) a TOTP key -- the user must confirm they can produce
            // a valid code before 2FA is turned on for real; see Manage > Two-factor authentication.
            await UserManager.ResetAuthenticatorKeyAsync(user);
            var rawKey = await UserManager.GetAuthenticatorKeyAsync(user) ?? string.Empty;

            _result = new CreatedLogin(username, password, FormatKey(rawKey), BuildQrCodeDataUri(username, rawKey));
            _firstName = string.Empty;
            _lastName = string.Empty;

            await RefreshLocalAccountsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "TeamLogins - Failed to create login for {First} {Last}", _firstName, _lastName);
            _errorMessage = $"Could not create the login: {ex.Message}";
        }
        finally
        {
            _creating = false;
            StateHasChanged();
        }
    }

    private async Task<string> GenerateUsernameAsync(string firstName, string lastName)
    {
        // The stock Login page's Email input requires email-shaped text client-side, so the
        // sign-in identifier needs an "@..." suffix even though it isn't a real mailbox.
        const string domain = "@teamlogin.local";
        var baseUsername = $"{firstName}.{lastName}";
        var candidate = baseUsername + domain;
        var suffix = 1;
        while (await UserManager.FindByNameAsync(candidate) != null)
        {
            suffix++;
            candidate = $"{baseUsername}{suffix}{domain}";
        }
        return candidate;
    }

    private static string FormatKey(string key)
    {
        var chunks = Enumerable.Range(0, (key.Length + 3) / 4)
            .Select(i => key.Substring(i * 4, Math.Min(4, key.Length - i * 4)));
        return string.Join(" ", chunks);
    }

    /// <summary>
    /// Renders the standard otpauth:// TOTP key URI as a QR code entirely server-side (QRCoder,
    /// pure managed code) -- the secret never leaves the app, unlike calling out to a third-party
    /// QR generation API, which would hand the TOTP secret to an external service.
    /// </summary>
    private static string BuildQrCodeDataUri(string username, string rawKey)
    {
        var label = Uri.EscapeDataString($"{Issuer}:{username}");
        var otpauthUri = $"otpauth://totp/{label}?secret={rawKey}&issuer={Uri.EscapeDataString(Issuer)}&digits=6";

        using var generator = new QRCodeGenerator();
        using var qrData = generator.CreateQrCode(otpauthUri, QRCodeGenerator.ECCLevel.Q);
        var pngBytes = new PngByteQRCode(qrData).GetGraphic(8);
        return $"data:image/png;base64,{Convert.ToBase64String(pngBytes)}";
    }

    private static string GenerateStrongPassword(int length = 16)
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ"; // no I/O -- avoids visual ambiguity
        const string lower = "abcdefghijkmnpqrstuvwxyz";
        const string digits = "23456789";
        const string special = "!@#$%^&*-_=+";
        const string all = upper + lower + digits + special;

        var chars = new char[length];
        for (var i = 0; i < length; i++)
            chars[i] = all[RandomNumberGenerator.GetInt32(all.Length)];

        // Guarantee at least one character from each required category
        chars[0] = upper[RandomNumberGenerator.GetInt32(upper.Length)];
        chars[1] = lower[RandomNumberGenerator.GetInt32(lower.Length)];
        chars[2] = digits[RandomNumberGenerator.GetInt32(digits.Length)];
        chars[3] = special[RandomNumberGenerator.GetInt32(special.Length)];

        // Shuffle so the guaranteed characters aren't always in the first four positions
        for (var i = chars.Length - 1; i > 0; i--)
        {
            var j = RandomNumberGenerator.GetInt32(i + 1);
            (chars[i], chars[j]) = (chars[j], chars[i]);
        }

        return new string(chars);
    }

    private void ShowDeactivateConfirm(ApplicationUser account)
    {
        _confirmAction = new ConfirmActionInfo(
            Message: $"Deactivate login for {account.UserName}? They will no longer be able to sign in.",
            Warning: "This action can be reversed by reactivating the account.",
            ButtonText: "Deactivate",
            ButtonClass: "btn-warning",
            Action: () => DeactivateLogin(account)
        );
    }

    private void ShowDeleteConfirm(ApplicationUser account)
    {
        _confirmAction = new ConfirmActionInfo(
            Message: $"Permanently delete login for {account.UserName}?",
            Warning: "This action cannot be undone. All data associated with this account will be deleted.",
            ButtonText: "Delete Permanently",
            ButtonClass: "btn-danger",
            Action: () => DeleteLogin(account)
        );
    }

    private void CancelConfirm()
    {
        _confirmAction = null;
    }

    private async Task ConfirmAction()
    {
        if (_confirmAction == null) return;
        _actionInProgress = true;
        StateHasChanged();
        try
        {
            await _confirmAction.Action();
        }
        finally
        {
            _actionInProgress = false;
            _confirmAction = null;
            StateHasChanged();
        }
    }

    private async Task DeactivateLogin(ApplicationUser account)
    {
        try
        {
            account.IsActive = false;
            account.DeactivatedUtc = DateTime.UtcNow;
            account.UpdatedUtc = DateTime.UtcNow;
            var result = await UserManager.UpdateAsync(account);
            if (result.Succeeded)
            {
                Logger.LogInformation("Deactivated login: {Username}", account.UserName);
                await RefreshLocalAccountsAsync();
            }
            else
            {
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to deactivate login {Username}", account.UserName);
            _errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task ReactivateLogin(ApplicationUser account)
    {
        try
        {
            account.IsActive = true;
            account.DeactivatedUtc = null;
            account.UpdatedUtc = DateTime.UtcNow;
            var result = await UserManager.UpdateAsync(account);
            if (result.Succeeded)
            {
                Logger.LogInformation("Reactivated login: {Username}", account.UserName);
                await RefreshLocalAccountsAsync();
            }
            else
            {
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reactivate login {Username}", account.UserName);
            _errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task ResetPassword(ApplicationUser account)
    {
        try
        {
            var newPassword = GenerateStrongPassword();
            var result = await UserManager.RemovePasswordAsync(account);
            if (!result.Succeeded)
            {
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }

            result = await UserManager.AddPasswordAsync(account, newPassword);
            if (!result.Succeeded)
            {
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }

            account.UpdatedUtc = DateTime.UtcNow;
            result = await UserManager.UpdateAsync(account);
            if (!result.Succeeded)
            {
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }

            Logger.LogInformation("Reset password for: {Username}", account.UserName);
            _resetPasswordResult = new ResetPasswordResult(account.UserName ?? "Unknown", newPassword);
            await RefreshLocalAccountsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset password for {Username}", account.UserName);
            _errorMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DeleteLogin(ApplicationUser account)
    {
        try
        {
            var result = await UserManager.DeleteAsync(account);
            if (result.Succeeded)
            {
                Logger.LogInformation("Deleted login: {Username}", account.UserName);
                await RefreshLocalAccountsAsync();
            }
            else
            {
                _errorMessage = string.Join(" ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete login {Username}", account.UserName);
            _errorMessage = $"Error: {ex.Message}";
        }
    }
}
