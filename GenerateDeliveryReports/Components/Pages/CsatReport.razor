
@page "/csat-report"
@rendermode InteractiveServer
@using GenerateDeliveryReports.Models
@using GenerateDeliveryReports.Data.Services
@inject CsatService CsatService
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS

<PageTitle>CSAT Report</PageTitle>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <pre style="white-space: pre-wrap; word-wrap: break-word;">@errorMessage</pre>
    </div>
}

<h1 class="mb-4">CSAT Report</h1>


<div class="container-fluid">

    @* ─── Client Selection ─── *@
    <div class="row mb-3">
        <div class="col-md-4">
            <label for="clientSelect" class="form-label fw-semibold">Client</label>
            <select id="clientSelect" class="form-select" @onchange="OnClientChanged" disabled="@isGenerating">
                <option value="">-- Select a Client --</option>
                @foreach (var name in clientNames)
                {
                    <option value="@name">@name</option>
                }
            </select>
        </div>
    </div>

    @if (isGenerating && sheetNames.Count > 0)
    {
        <div class="d-flex align-items-center mb-3">
            <div class="spinner-border spinner-border-sm text-primary me-2"></div>
            <span class="small text-muted">Generating PDFs… (@generatedPdfs.Count of @sheetNames.Count done)</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(selectedClient))
    {
        @* Dynamic split: no preview → wider left; preview open → 5/7 split *@
        <div class="row">
            <div class="@(showPreview ? "col-md-5" : "col-md-8")">

                @* ── Sheet list ── *@
                <div class="card mb-3">
                    <div class="card-header fw-semibold">CSAT Sheets</div>
                    <div class="card-body p-2">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small mb-2">@errorMessage</div>
                        }
                        @if (sheetNames.Count == 0)
                        {
                            <p class="text-muted small">No sheets configured for this client.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var sheet in sheetNames)
                                {
                                    bool hasPdf = generatedPdfs.ContainsKey(sheet);
                                    bool isActive = previewSheet == sheet && showPreview;
                                    <li class="list-group-item d-flex align-items-center justify-content-between py-2 px-3
                                               @(isActive ? "list-group-item-primary" : "")">
                                        <span class="@(hasPdf ? "fw-semibold" : "")"
                                              style="@(hasPdf ? "cursor:pointer" : "")"
                                              @onclick="() => { if (hasPdf) ShowPreview(sheet); }">
                                            @sheet
                                            @if (hasPdf)
                                            {
                                                <span class="badge bg-success ms-2">PDF</span>
                                            }
                                        </span>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (generatingSheet == sheet)
                                            {
                                                <span class="spinner-border spinner-border-sm text-secondary"></span>
                                            }
                                            else if (hasPdf)
                                            {
                                                @* Attach checkbox *@
                                                <div class="form-check mb-0" title="Attach to email">
                                                    <input type="checkbox"
                                                           class="form-check-input"
                                                           id="chk_@sheet"
                                                           checked="@attachedSheets.Contains(sheet)"
                                                           @onchange="e => ToggleAttachment(sheet, (bool)e.Value!)" />
                                                    <label class="form-check-label small" for="chk_@sheet">Attach</label>
                                                </div>
                                                @* Preview button *@
                                                <button class="btn btn-outline-primary btn-sm"
                                                        @onclick="() => ShowPreview(sheet)">
                                                    Preview
                                                </button>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                @* ── Attachments ── *@
                @* ── Attachments ── *@
                @if (attachedSheets.Count > 0)
                {
                    <div class="card mb-3">
                        <div class="card-header fw-semibold">Attachments</div>
                        <div class="card-body p-2">
                            <ul class="list-group list-group-flush">
                                @foreach (var sheet in attachedSheets)
                                {
                                    <li class="list-group-item d-flex align-items-center justify-content-between py-2 px-3">
                                        <span class="small">@sheet</span>
                                        <a href="@generatedPdfs[sheet]" target="_blank" class="btn btn-outline-secondary btn-sm">Download</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
                    
                @* ── Email Form ── *@
                <div class="card">
                    <div class="card-header fw-semibold">Send Email</div>
                    <div class="card-body">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">From</label>
                            <input type="email" class="form-control form-control-sm" @bind="emailFrom" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">To</label>
                            <input type="email" class="form-control form-control-sm" @bind="emailTo" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Subject</label>
                            <input type="text" class="form-control form-control-sm" @bind="emailSubject" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Body</label>
                            <textarea class="form-control form-control-sm" rows="5" @bind="emailBody"></textarea>
                        </div>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary"
                                    disabled="@(attachedSheets.Count == 0 || isSending)"
                                    @onclick="SendEmail">
                                @if (isSending)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                Send (@attachedSheets.Count attachment@(attachedSheets.Count == 1 ? "" : "s"))
                            </button>
                            <div class="btn-group" role="group">
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        disabled="@(string.IsNullOrEmpty(emailTo) || string.IsNullOrEmpty(emailSubject))"
                                        @onclick="DownloadEmailAsEml">
                                    📥 Download as EML
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        disabled="@(string.IsNullOrEmpty(emailTo) || string.IsNullOrEmpty(emailSubject))"
                                        @onclick="OpenInDesktopOutlook">
                                    🖥️ Open in Outlook
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        disabled="@(string.IsNullOrEmpty(emailTo) || string.IsNullOrEmpty(emailSubject))"
                                        @onclick="OpenInOutlookWeb">
                                    🌐 Outlook Web
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(sendResult))
                        {
                            <div class="alert @(sendSuccess ? "alert-success" : "alert-danger") mt-2 py-2 small">
                                @sendResult
                            </div>
                        }
                    </div>
                </div>

            </div>

            @* ─── Right panel: PDF Preview (hidden until a PDF is selected) ─── *@
            @if (showPreview)
            {
                <div class="col-md-7">
                    <div class="card h-100">
                        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                            <span>Preview — @previewSheet</span>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClosePreview">✕ Close</button>
                        </div>
                        <div class="card-body p-0">
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger m-3 small">@errorMessage</div>
                            }
                            else
                            {
                                <iframe src="@previewPdfUrl" style="width:100%;height:700px;border:none;"></iframe>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if(MinutesService != null){
@* ─── Meeting Minutes Panel ─── *@
<hr class="my-4" />
<div class="container-fluid">
    <h4 class="mb-3">Meeting Minutes</h4>

    @* Model download status *@
    @if (!minutesModelReady)
    {
        <div class="alert alert-info py-2 small d-flex align-items-center gap-2">
            <span class="spinner-border spinner-border-sm"></span>
            <span>Preparing Whisper model… (first run downloads ~145 MB)</span>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
            <span>Record Meeting Audio</span>
            @if (isRecording)
            {
                <span class="badge bg-danger">● REC @recordingDuration</span>
            }
        </div>
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-danger"
                        disabled="@(isRecording || isTranscribing || !minutesModelReady)"
                        @onclick="StartRecording">
                    ● Start Recording
                </button>
                <button class="btn btn-secondary"
                        disabled="@(!isRecording)"
                        @onclick="StopAndTranscribe">
                    ■ Stop &amp; Transcribe
                </button>
                <button class="btn btn-outline-secondary"
                        disabled="@(string.IsNullOrEmpty(transcript) || isGeneratingMinutes)"
                        @onclick="GenerateMinutes">
                    ✦ Generate Minutes
                </button>
                <button class="btn btn-outline-danger btn-sm ms-auto"
                        disabled="@(isRecording || isTranscribing || isGeneratingMinutes)"
                        @onclick="ClearMinutes">
                    Clear
                </button>
            </div>

            @if (!string.IsNullOrEmpty(minutesError))
            {
                <div class="alert alert-danger mt-3 py-2 small">@minutesError</div>
            }

            @if (isTranscribing)
            {
                <div class="d-flex align-items-center gap-2 mt-3 text-muted small">
                    <span class="spinner-border spinner-border-sm"></span>
                    Transcribing audio…
                </div>
            }

            @if (!string.IsNullOrEmpty(transcript))
            {
                <div class="mt-3">
                    <label class="form-label small fw-semibold">Transcript</label>
                    <textarea class="form-control form-control-sm font-monospace"
                              rows="6"
                              @bind="transcript"></textarea>
                </div>
            }
        </div>
    </div>

    @if (isGeneratingMinutes)
    {
        <div class="d-flex align-items-center gap-2 text-muted small mb-3">
            <span class="spinner-border spinner-border-sm"></span>
            Generating minutes via Ollama…
        </div>
    }

    @if (!string.IsNullOrEmpty(meetingMinutes))
    {
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Meeting Minutes</span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="CopyMinutes">Copy</button>
            </div>
            <div class="card-body">
                <pre class="mb-0" style="white-space:pre-wrap;font-size:.85rem;">@meetingMinutes</pre>
            </div>
        </div>
    }
</div>
}

@code {
    private IEnumerable<string> clientNames = [];
    private List<string> sheetNames = [];
    private string selectedClient = string.Empty;
    private string previewSheet = string.Empty;
    private string previewPdfUrl = string.Empty;
    private string errorMessage = string.Empty;
    private string generatingSheet = string.Empty;   // which sheet is currently generating
    private bool isGenerating = false;
    private bool showPreview = false;
    private bool isSending = false;
    private bool sendSuccess = false;
    private string sendResult = string.Empty;

    private Dictionary<string, string> generatedPdfs = new();
    private HashSet<string> attachedSheets = new();

    private string emailFrom = string.Empty;
    private string emailTo = string.Empty;
    private string emailSubject = string.Empty;
    private string emailBody = string.Empty;

    // ── Meeting Minutes state ──
    private bool minutesModelReady = false;
    private bool isRecording = false;
    private bool isTranscribing = false;
    private bool isGeneratingMinutes = false;
    private string transcript = string.Empty;
    private string meetingMinutes = string.Empty;
    private string minutesError = string.Empty;
    private string recordingDuration = "0:00";
    private System.Timers.Timer? _recordingTimer;
    private int _recordingSeconds = 0;
    private MeetingMinutesService? MinutesService;

    protected override void OnInitialized()
    {
        try
        {
            clientNames = CsatService.GetClientNames();
            emailFrom = CsatService.GetDefaultFromEmail();

            // Manually resolve MeetingMinutesService if available (Development only)
            MinutesService = ServiceProvider.GetService(typeof(MeetingMinutesService)) as MeetingMinutesService;
        }
        catch (Exception ex)
        {
            errorMessage = $"CSAT ERROR: {ex.GetType().Name}\n{ex.Message}\n\nStack: {ex.StackTrace}";
            Console.Error.WriteLine(errorMessage);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            minutesModelReady = MinutesService.IsModelDownloaded();
            if (!minutesModelReady)
            {
                StateHasChanged();
                await Task.Run(async () => await MinutesService.EnsureModelDownloadedAsync());
                minutesModelReady = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task StartRecording()
    {
        minutesError = string.Empty;
        try
        {
            await JS.InvokeVoidAsync("audioRecorder.start");
            isRecording = true;
            _recordingSeconds = 0;
            _recordingTimer = new System.Timers.Timer(1000);
            _recordingTimer.Elapsed += (_, _) =>
            {
                _recordingSeconds++;
                recordingDuration = $"{_recordingSeconds / 60}:{_recordingSeconds % 60:D2}";
                InvokeAsync(StateHasChanged);
            };
            _recordingTimer.Start();
        }
        catch (Exception ex)
        {
            minutesError = $"Microphone access error: {ex.Message}";
        }
    }

    private async Task StopAndTranscribe()
    {
        _recordingTimer?.Stop();
        _recordingTimer?.Dispose();
        _recordingTimer = null;
        isRecording = false;
        isTranscribing = true;
        minutesError = string.Empty;
        StateHasChanged();

        try
        {
            var base64Wav = await JS.InvokeAsync<string>("audioRecorder.stop");
            var wavBytes = Convert.FromBase64String(base64Wav);
            transcript = await MinutesService.TranscribeAsync(wavBytes);
        }
        catch (Exception ex)
        {
            minutesError = $"Transcription error: {ex.Message}";
        }
        finally
        {
            isTranscribing = false;
            StateHasChanged();
        }
    }

    private async Task GenerateMinutes()
    {
        if (string.IsNullOrWhiteSpace(transcript)) return;
        isGeneratingMinutes = true;
        minutesError = string.Empty;
        meetingMinutes = string.Empty;
        StateHasChanged();

        try
        {
            meetingMinutes = await MinutesService.GenerateMinutesAsync(transcript);
        }
        catch (Exception ex)
        {
            minutesError = ex.Message;
        }
        finally
        {
            isGeneratingMinutes = false;
            StateHasChanged();
        }
    }

    private async Task CopyMinutes()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", meetingMinutes);
    }

    private void ClearMinutes()
    {
        transcript = string.Empty;
        meetingMinutes = string.Empty;
        minutesError = string.Empty;
        recordingDuration = "0:00";
    }

    private async Task OnClientChanged(ChangeEventArgs e)
    {
        selectedClient = e.Value?.ToString() ?? string.Empty;
        sheetNames = CsatService.GetSheetNames(selectedClient).ToList();
        generatedPdfs.Clear();
        attachedSheets.Clear();
        previewSheet = string.Empty;
        previewPdfUrl = string.Empty;
        showPreview = false;
        errorMessage = string.Empty;

        // Pre-populate email fields from config
        emailFrom = CsatService.GetDefaultFromEmail();
        emailTo = CsatService.GetClientEmail(selectedClient);
        emailSubject = CsatService.GetClientSubject(selectedClient);
        emailBody = CsatService.GetClientEmailBody(selectedClient);

        // Auto-generate PDFs for all sheets
        if (sheetNames.Count > 0)
        {
            isGenerating = true;
            foreach (var sheet in sheetNames)
            {
                generatingSheet = sheet;
                StateHasChanged();

                string? generatedUrl = null;
                await Task.Run(() =>
                {
                    try
                    {
                        generatedUrl = CsatService.GenerateSheetPdf(selectedClient, sheet);
                    }
                    catch (Exception ex)
                    {
                        errorMessage = $"Error generating PDF for '{sheet}': {ex.Message}";
                    }
                });

                // Update dictionary on the Blazor context after Task.Run returns
                if (generatedUrl != null)
                {
                    generatedPdfs[sheet] = generatedUrl;
                    attachedSheets.Add(sheet); // auto-check the sheet
                }

                StateHasChanged(); // reveal badge + checkbox for this sheet immediately
            }
            generatingSheet = string.Empty;
            isGenerating = false;
            StateHasChanged();
        }
    }

    private void ShowPreview(string sheet)
    {
        if (!generatedPdfs.TryGetValue(sheet, out var url)) return;
        previewSheet = sheet;
        previewPdfUrl = url;
        showPreview = true;
        errorMessage = string.Empty;
    }

    private void ClosePreview()
    {
        showPreview = false;
        previewSheet = string.Empty;
        previewPdfUrl = string.Empty;
    }

    private void ToggleAttachment(string sheet, bool attach)
    {
        if (attach) attachedSheets.Add(sheet);
        else attachedSheets.Remove(sheet);
    }

    private async Task SendEmail()
    {
        isSending = true;
        sendResult = string.Empty;
        StateHasChanged();

        var attachmentPaths = attachedSheets
            .Where(s => generatedPdfs.ContainsKey(s))
            .Select(s => generatedPdfs[s]);

        (sendSuccess, sendResult) = await Task.Run(() =>
            CsatService.SendEmail(emailFrom, emailTo, emailSubject, emailBody, attachmentPaths));

        isSending = false;
        StateHasChanged();
    }

    private async Task DownloadEmailAsEml()
    {
        try
        {
            var queryParams = new Dictionary<string, string>
            {
                { "clientName", selectedClient },
                { "from", emailFrom },
                { "to", emailTo },
                { "subject", emailSubject },
                { "body", emailBody }
            };

            var query = string.Join("&", queryParams.Select(kvp => $"{kvp.Key}={Uri.EscapeDataString(kvp.Value)}"));
            var url = $"/api/csat/download-email?{query}";

            await JS.InvokeVoidAsync("window.open", url, "_blank");
        }
        catch (Exception ex)
        {
            sendResult = $"Error: {ex.Message}";
            sendSuccess = false;
            StateHasChanged();
        }
    }

    private async Task OpenInDesktopOutlook()
    {
        try
        {
            var mailtoUri = $"mailto:{Uri.EscapeDataString(emailTo)}"
                + $"?subject={Uri.EscapeDataString(emailSubject)}"
                + $"&body={Uri.EscapeDataString(emailBody)}";

            await JS.InvokeVoidAsync("window.open", mailtoUri);
        }
        catch (Exception ex)
        {
            sendResult = $"Error: {ex.Message}";
            sendSuccess = false;
            StateHasChanged();
        }
    }

    private async Task OpenInOutlookWeb()
    {
        try
        {
            var subject = Uri.EscapeDataString(emailSubject);
            var body = Uri.EscapeDataString(emailBody);
            var outlookWebUrl = $"https://outlook.office.com/mail/deeplink/compose?to={emailTo}&subject={subject}&body={body}";

            await JS.InvokeVoidAsync("window.open", outlookWebUrl, "_blank");
        }
        catch (Exception ex)
        {
            sendResult = $"Error: {ex.Message}";
            sendSuccess = false;
            StateHasChanged();
        }
    }
}

